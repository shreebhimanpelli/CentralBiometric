generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HOD
  EVENT_COORDINATOR
  STAFF
  STUDENT
}

model Department {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  users     User[]
  events    Event[]
  createdAt DateTime @default(now())
}

model User {
  id                String             @id @default(cuid())
  userId            String             @unique
  passwordHash      String
  name              String
  role              Role
  departmentId      String?
  batch             String?
  department        Department?        @relation(fields: [departmentId], references: [id])
  punchLogs         PunchLog[]
  eventAttendance   EventAttendance[]
  eventEnrollments  EventEnrollment[]
  coordinatedEvents EventCoordinator[]
  refreshTokens     RefreshToken[]
  createdAt         DateTime           @default(now())

  @@index([departmentId, batch, role])
}

model PunchLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  deviceId  String?
  punchTime DateTime
  direction String?
  esslLogId String?  @unique
  createdAt DateTime @default(now())

  @@index([userId, punchTime])
  @@index([punchTime])
}

model Event {
  id           String             @id @default(cuid())
  name         String
  description  String?
  venue        String?
  deviceId     String?
  startTime    DateTime
  endTime      DateTime
  departmentId String
  department   Department         @relation(fields: [departmentId], references: [id])
  coordinators EventCoordinator[]
  enrollments  EventEnrollment[]
  attendance   EventAttendance[]
  createdAt    DateTime           @default(now())

  @@index([departmentId, startTime])
}

model EventEnrollment {
  id      String   @id @default(cuid())
  eventId String
  userId  String
  batch   String?
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
}

model EventCoordinator {
  id      String @id @default(cuid())
  eventId String
  userId  String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model EventAttendance {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  punchTime DateTime
  deviceId  String?
  esslLogId String?  @unique
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([eventId, punchTime])
  @@index([userId])
  @@index([eventId, deviceId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model SyncCursor {
  id           String    @id @default("default")
  lastSyncedAt DateTime?
  lastEsslId   String?
}
